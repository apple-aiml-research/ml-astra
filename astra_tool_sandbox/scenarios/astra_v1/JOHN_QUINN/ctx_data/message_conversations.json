            ],
            "messages": [
                {
                    "sender": "john.quinn@palantir.com",
                    "sender_name": "John Quinn",
                    "content": "Hey Apricot! I've been thinking about our hike for the Sunday after next. I've got 4 trails in mind, each with something unique. Let me know which one sounds good to you!",
